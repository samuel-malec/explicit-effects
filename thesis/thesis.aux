\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Evaluation. An outcome $r$ is $\mathsf  {ret}(\bar  v, \sigma )$, $\mathsf  {exc}(o, \sigma )$, an exception $o$ with the heap the method leaves it in, or $\lightning $. An initialization, with a token or without, evaluates as \textsc  {Set}, and $\mathsf  {exception}$ as \textsc  {New}, for the class of its exception; $\mathsf  {dup}$, $\mathsf  {drop}$ and $\mathsf  {move}$ only change the environment; \textsc  {Null} applies to a load, a store and an initialization through $\mathsf  {null}$; $\mathsf  {if}$ with $\rho (y) = \mathit  {ff}$ goes to $b_2$; a guard passes $b$ the values $\bar  y_b$ the branch it abbreviates passed; a method is invoked as its entry block, with $\bullet $ for each token, $\langle m, \bar  v, \sigma  \rangle  \Downarrow r$ if $\langle b_m, \bar  v\,\bar  \bullet , \sigma  \rangle  \Downarrow r$, and $\mathsf  {ret}$ gives back only the values. $0_f$ is the default value of field $f$, \textsc  {New} also sets the header fields, and $o_{\mathrm  {oom}}$ and $o_{\mathrm  {soe}}$ are an \texttt  {OutOfMemoryError} and a \texttt  {StackOverflowError} the virtual machine makes.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ee-semantics}{{3.4}{9}{Evaluation. An outcome $r$ is $\Ret (\bar v, \sigma )$, $\Exc (o, \sigma )$, an exception $o$ with the heap the method leaves it in, or $\Trap $. An initialization, with a token or without, evaluates as \textsc {Set}, and $\exn $ as \textsc {New}, for the class of its exception; $\dup $, $\drop $ and $\move $ only change the environment; \textsc {Null} applies to a load, a store and an initialization through $\nul $; $\mathsf {if}$ with $\rho (y) = \tfalse $ goes to $b_2$; a guard passes $b$ the values $\bar y_b$ the branch it abbreviates passed; a method is invoked as its entry block, with $\tok $ for each token, $\cfg {m, \bar v, \sigma } \Downarrow r$ if $\cfg {b_m, \bar v\,\bar \tok , \sigma } \Downarrow r$, and $\Ret $ gives back only the values. $0_f$ is the default value of field $f$, \textsc {New} also sets the header fields, and $o_{\mathrm {oom}}$ and $o_{\mathrm {soe}}$ are an \texttt {OutOfMemoryError} and a \texttt {StackOverflowError} the virtual machine makes}{figure.caption.9}{}}
\newlabel{fig:ee-semantics@cref}{{[figure][4][3]3.4}{[1][8][]9}}
