type int
type long
type float
type double
type ref
type bool
type heap
type stck

signature lattice[ T, B ]
(
    join ∷ T × T → T
    bot  ∷ ∅ → T
    top  ∷ ∅ → T
    opt  ∷ B × T → T
)

signature linear[ T, S, B ] : lattice[ T, B ]
(
    fork ∷ T → T × T
    move ∷ T → T
    push ∷ S × T → S
    pop  ∷ S → T × S
)

signature affine[ T, S, B ] : linear[ T, S, B ]
(
    drop ∷ T → ∅
)

signature simple[ T, S, B ] : affine[ T, S, B ]
(
    dup ∷ T → T × T
)

signature arithmetic[ T, S, B ] : simple[ T, S, B ]
(
    add  ∷ T × T → T
    sub  ∷ T × T → T
    mul  ∷ T × T → T
    div  ∷ T × T → T
    rem  ∷ T × T → T
    neg  ∷ T → T

    eq?  ∷ T × T → B
    lt?  ∷ T × T → B
    ult? ∷ T × T → B

    abs  ∷ T → T
    min  ∷ T × T → T
    max  ∷ T × T → T
)

signature bitwise[ T, I ]
(
    and  ∷ T × T → T
    or   ∷ T × T → T
    xor  ∷ T × T → T
    not  ∷ T → T 
    shl  ∷ T × I → T
    shr  ∷ T × I → T
    ushr ∷ T × I → T
)

signature floating[ T, S, B ] : simple[ T, S, B ]
(
    add  ∷ T × T → T
    sub  ∷ T × T → T
    mul  ∷ T × T → T
    div  ∷ T × T → T
    rem  ∷ T × T → T
    neg  ∷ T → T
    abs  ∷ T → T
    sqrt ∷ T → T
    min  ∷ T × T → T
    max  ∷ T × T → T

    eq?  ∷ T × T → B
    lt?  ∷ T × T → B
)

; Graal's conversions between numbers, narrowing included, and its three-way comparison.
signature numeric[ T, I ]
(
    to_int    ∷ T → int
    to_long   ∷ T → long
    to_float  ∷ T → float
    to_double ∷ T → double
    cmp       ∷ T × T → I
)

signature logical[ B, S ] : simple[ B, S, B ]
(
    not ∷ B → B
    and ∷ B × B → B
    or  ∷ B × B → B
)

signature reference[ R, S, B, I ] : simple[ R, S, B ]
(
    null   ∷ ∅ → R
    nil?   ∷ R → B
    eq?    ∷ R × R → B
    length ∷ R → I
    hub    ∷ R → R  ; the object's class
    isinstance ∷ R × R → B
    exception ∷ ∅ → R  ; a new exception
)

; An exception is control flow: a method gives back the exception it threw, null when it
; returned normally, and its caller branches on it.
signature memory[ H, S, B ] : linear[ H, S, B ]
(
    trap ∷ H → ∅        ; the program stops: a deoptimization, which ahead-of-time code never comes back from
    guard ∷ H × B → H   ; leaves the method when B holds, as a branch to an arm that throws or traps would
    acquire ∷ H → H     ; synchronization that may show this thread what other threads wrote: the memory may have changed
    release ∷ H → H     ; synchronization that may show other threads what this thread wrote: the memory is read, and stays as it was
)

signature function[ F, S, B, I, O, G ] : simple[ F, S, B ]
(
    call ∷ F × I → O
    opt  ∷ B × F → F
    join ∷ F × F × G → F
)

structure int : arithmetic[ int, stck, bool ], bitwise[ int, int ], numeric[ int, int ]
(
    join = graal_int_join   ; lattice
    bot  = graal_int_bot
    top  = graal_int_top
    opt  = graal_int_opt
    fork = graal_int_fork   ; linear
    move = graal_int_move
    push = graal_int_push
    pop  = graal_int_pop
    drop = graal_int_drop   ; affine
    dup  = graal_int_dup    ; simple

    add  = graal_int_add    ; arithmetic
    sub  = graal_int_sub
    mul  = graal_int_mul
    div  = graal_int_div
    rem  = graal_int_rem
    neg  = graal_int_neg
    eq?  = graal_int_eq
    lt?  = graal_int_lt
    ult? = graal_int_ult
    abs  = graal_int_abs
    min  = graal_int_min
    max  = graal_int_max

    and  = graal_int_and    ; bitwise
    or   = graal_int_or
    xor  = graal_int_xor
    not  = graal_int_not
    shl  = graal_int_shl
    shr  = graal_int_shr
    ushr = graal_int_ushr

    to_int    = graal_int_to_int   ; numeric
    to_long   = graal_int_to_long
    to_float  = graal_int_to_float
    to_double = graal_int_to_double
    cmp       = graal_int_cmp
)

