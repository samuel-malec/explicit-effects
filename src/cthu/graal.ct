    pop    = graal_ref_pop
    drop   = graal_ref_drop   ; affine
    dup    = graal_ref_dup    ; simple

    null   = graal_ref_null   ; reference
    nil?   = graal_ref_nil
    eq?    = graal_ref_eq
    length = graal_ref_length
    hub    = graal_ref_hub
    isinstance = graal_ref_isinstance
    exception = graal_ref_exception
)

