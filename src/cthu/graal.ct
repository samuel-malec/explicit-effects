    sub  = graal_long_sub
    mul  = graal_long_mul
    div  = graal_long_div
    rem  = graal_long_rem
    neg  = graal_long_neg
    eq?  = graal_long_eq
    lt?  = graal_long_lt
    ult? = graal_long_ult
    abs  = graal_long_abs
    min  = graal_long_min
    max  = graal_long_max

    and  = graal_long_and    ; bitwise
    or   = graal_long_or
    xor  = graal_long_xor
    not  = graal_long_not
    shl  = graal_long_shl
    shr  = graal_long_shr
    ushr = graal_long_ushr

    to_int    = graal_long_to_int   ; numeric
    to_long   = graal_long_to_long
    to_float  = graal_long_to_float
    to_double = graal_long_to_double
    cmp       = graal_long_cmp
)

