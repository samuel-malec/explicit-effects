type int    ; also Java's boolean, byte, char and short
type long
type float
type double
type ref
type bool   ; not to be confused with Java's boolean; it is the input type of opt and the result of comparisons
type heap
type stck

signature lattice[ T, B ]
(
    join ∷ T × T → T
    bot  ∷ ∅ → T
    top  ∷ ∅ → T
    opt  ∷ B × T → T
)

signature linear[ T, S, B ] : lattice[ T, B ]
(
    fork ∷ T → T × T
    move ∷ T → T
    push ∷ S × T → S
    pop  ∷ S → T × S
)

signature affine[ T, S, B ] : linear[ T, S, B ]
(
    drop ∷ T → ∅
)

signature simple[ T, S, B ] : affine[ T, S, B ]
(
    dup ∷ T → T × T
)

signature arithmetic[ T, S, B ] : simple[ T, S, B ]
(
    add  ∷ T × T → T
    sub  ∷ T × T → T
    mul  ∷ T × T → T
    div  ∷ T × T → T
    rem  ∷ T × T → T
    neg  ∷ T → T

    eq?  ∷ T × T → B
    lt?  ∷ T × T → B
    ult? ∷ T × T → B
)

; The shift amount is always an int, also for a long, and is masked as in
; Java: to 0-31 for an int, to 0-63 for a long.
signature bitwise[ T, I ]
(
    and  ∷ T × T → T
    or   ∷ T × T → T
    xor  ∷ T × T → T
    not  ∷ T → T 
    shl  ∷ T × I → T
    shr  ∷ T × I → T
    ushr ∷ T × I → T
)

signature floating[ T, S, B ] : simple[ T, S, B ]
(
    add ∷ T × T → T
    sub ∷ T × T → T
    mul ∷ T × T → T
    neg ∷ T → T
)

signature logical[ B, S ] : simple[ B, S, B ]
(
    not ∷ B → B
)

signature reference[ R, S, B, I ] : simple[ R, S, B ]
(
    null   ∷ ∅ → R
    nil?   ∷ R → B
    eq?    ∷ R × R → B
    length ∷ R → I
)

signature memory[ H, S, B ] : linear[ H, S, B ]
(
    trap ∷ H → ∅        ; for now, this is how we model a Java exception
)

signature function[ F, S, B, I, O, G ] : simple[ F, S, B ]
(
    call ∷ F × I → O
    opt  ∷ B × F → F
    join ∷ F × F × G → F
)

structure int : arithmetic[ int, stck, bool ], bitwise[ int, int ]
(
    join = java_int_join   ; lattice
    bot  = java_int_bot
    top  = java_int_top
    opt  = java_int_opt
    fork = java_int_fork   ; linear
    move = java_int_move
    push = java_int_push
    pop  = java_int_pop
    drop = java_int_drop   ; affine
    dup  = java_int_dup    ; simple

    add  = java_int_add    ; arithmetic
    sub  = java_int_sub
    mul  = java_int_mul
    div  = java_int_div
    rem  = java_int_rem
    neg  = java_int_neg
    eq?  = java_int_eq
    lt?  = java_int_lt
    ult? = java_int_ult

    and  = java_int_and    ; bitwise
    or   = java_int_or
    xor  = java_int_xor
    not  = java_int_not
    shl  = java_int_shl
    shr  = java_int_shr
    ushr = java_int_ushr
)

structure long : arithmetic[ long, stck, bool ], bitwise[ long, int ]
(
    join = java_long_join   ; lattice
    bot  = java_long_bot
    top  = java_long_top
    opt  = java_long_opt
    fork = java_long_fork   ; linear
    move = java_long_move
    push = java_long_push
    pop  = java_long_pop
    drop = java_long_drop   ; affine
    dup  = java_long_dup    ; simple

    add  = java_long_add    ; arithmetic
    sub  = java_long_sub
    mul  = java_long_mul
    div  = java_long_div
    rem  = java_long_rem
    neg  = java_long_neg
    eq?  = java_long_eq
    lt?  = java_long_lt
    ult? = java_long_ult

    and  = java_long_and    ; bitwise
    or   = java_long_or
    xor  = java_long_xor
    not  = java_long_not
    shl  = java_long_shl
    shr  = java_long_shr
    ushr = java_long_ushr
)

structure float : floating[ float, stck, bool ]
(
    join = java_float_join   ; lattice
    bot  = java_float_bot
    top  = java_float_top
    opt  = java_float_opt
    fork = java_float_fork   ; linear
    move = java_float_move
    push = java_float_push
    pop  = java_float_pop
    drop = java_float_drop   ; affine
    dup  = java_float_dup    ; simple

    add  = java_float_add    ; floating
    sub  = java_float_sub
    mul  = java_float_mul
    neg  = java_float_neg
)

structure double : floating[ double, stck, bool ]
(
    join = java_double_join   ; lattice
    bot  = java_double_bot
    top  = java_double_top
    opt  = java_double_opt
    fork = java_double_fork   ; linear
    move = java_double_move
    push = java_double_push
    pop  = java_double_pop
    drop = java_double_drop   ; affine
    dup  = java_double_dup    ; simple

    add  = java_double_add    ; floating
    sub  = java_double_sub
    mul  = java_double_mul
    neg  = java_double_neg
)

structure bool : logical[ bool, stck ]
(
    join = java_bool_join   ; lattice
    bot  = java_bool_bot
    top  = java_bool_top
    opt  = java_bool_opt
    fork = java_bool_fork   ; linear
    move = java_bool_move
    push = java_bool_push
    pop  = java_bool_pop
    drop = java_bool_drop   ; affine
    dup  = java_bool_dup    ; simple

    not  = java_bool_not    ; logical
)

structure ref : reference[ ref, stck, bool, int ]
(
    join   = java_ref_join   ; lattice
    bot    = java_ref_bot
    top    = java_ref_top
    opt    = java_ref_opt
    fork   = java_ref_fork   ; linear
    move   = java_ref_move
    push   = java_ref_push
    pop    = java_ref_pop
    drop   = java_ref_drop   ; affine
    dup    = java_ref_dup    ; simple

    null   = java_ref_null   ; reference
    nil?   = java_ref_nil
    eq?    = java_ref_eq
    length = java_ref_length
)

structure heap : memory[ heap, stck, bool ]
(
    join = java_heap_join   ; lattice
    bot  = java_heap_bot
    top  = java_heap_top
    opt  = java_heap_opt
    fork = java_heap_fork   ; linear
    move = java_heap_move
    push = java_heap_push
    pop  = java_heap_pop

    trap = java_heap_trap   ; memory
)
